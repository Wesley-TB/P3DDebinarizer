<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>P3DDebin</AssemblyName>
    <RootNamespace>P3DDebin</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Company>P3DDebin</Company>
    <Product>P3D Debinarizer</Product>
    <Description>Debinariza, extrai RVMATs / model.cfg e troca caminhos de modelos .p3d do Arma 3.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BisDll">
      <HintPath>BisDll.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
